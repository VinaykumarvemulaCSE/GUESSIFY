rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. User Profiles & Subcollections (history, stats)
    // Public read for leaderboards and player lookups; owner can write
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // 2. Multiplayer Rooms & Guesses
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;

      match /guesses/{guessId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 3. Leaderboards (Weekly, Monthly, All-Time)
    // Public read so everyone can view ranks; authenticated users can update their entry
    match /leaderboards/{period}/entries/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 4. Global match history
    match /history/{historyId} {
      allow read, write: if isAuthenticated();
    }
  }
}
