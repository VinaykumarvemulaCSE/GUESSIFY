# Guessify Firebase Configuration
# Expo automatically inlines any variable starting with EXPO_PUBLIC_ into the mobile bundle.
# Replace these values with your Firebase Project Settings -> General -> Your apps -> Web/App SDK config.

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyKey_ReplaceWithYourActualKey
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=guessify-game.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=guessify-game
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=guessify-game.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
